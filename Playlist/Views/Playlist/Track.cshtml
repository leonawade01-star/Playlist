@{
}

<h1>Track @ViewData["Number"]: @ViewData["Item"]</h1>

@if (ViewData["Previous"] != null)
{
    <a asp-action="Track" asp-route-number="@ViewData["Previous"]">Prev</a>
}

@if (ViewData["Next"] != null)
{
    <a asp-action="Track" asp-route-number="@ViewData["Next"]">Next</a>
}


