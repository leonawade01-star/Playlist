@{
}

<h1>Search</h1>

@if (ViewData["Song"] != null)
{
    <p>@ViewData["Song"]</p>

    <a asp-action="Track" asp-route-number="@ViewData["Number"]">Play it</a>
}
else
{
    <p>No track matches @ViewData["Word"]</p>
}